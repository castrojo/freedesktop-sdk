From 2b4db918a80612eb1c677d04c4b2052b8e14b222 Mon Sep 17 00:00:00 2001
From: Aedan McHale <aedan.mchale@codethink.co.uk>
Date: Tue, 27 Oct 2026 09:28:07 +0000
Subject: [PATCH 1/1] Unpin Cython

---
 pyproject.toml                                   | 2 +-
 setup.py                                         | 2 +-
 src/python/grpcio_observability/pyproject.toml   | 2 +-
 tools/distrib/python/grpcio_tools/pyproject.toml | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 39cbfa5182..6b418a4e13 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -16,7 +16,7 @@
 requires = [
     "setuptools>=77.0.1",
     "wheel",
-    "Cython~=3.2",
+    "Cython>=3.2",
 ]
 build-backend = "setuptools.build_meta"
 
diff --git a/setup.py b/setup.py
index 0a811c9131..83352e5888 100644
--- a/setup.py
+++ b/setup.py
@@ -584,7 +584,7 @@ except ImportError:
         sys.stderr.write(
             "We could not find Cython. Setup may take 10-20 minutes.\n"
         )
-        SETUP_REQUIRES += ("Cython~=3.2",)
+        SETUP_REQUIRES += ("Cython>=3.2",)
 
 COMMAND_CLASS = {
     "doc": commands.SphinxDocumentation,
diff --git a/src/python/grpcio_observability/pyproject.toml b/src/python/grpcio_observability/pyproject.toml
index aeabb28d61..a61bfec6ee 100644
--- a/src/python/grpcio_observability/pyproject.toml
+++ b/src/python/grpcio_observability/pyproject.toml
@@ -16,7 +16,7 @@
 requires = [
     "setuptools>=77.0.1",
     "wheel",
-    "Cython~=3.2",
+    "Cython>=3.2",
 ]
 build-backend = "setuptools.build_meta"
 
diff --git a/tools/distrib/python/grpcio_tools/pyproject.toml b/tools/distrib/python/grpcio_tools/pyproject.toml
index 5a79cc45da..290fa7b65c 100644
--- a/tools/distrib/python/grpcio_tools/pyproject.toml
+++ b/tools/distrib/python/grpcio_tools/pyproject.toml
@@ -16,7 +16,7 @@
 requires = [
     "setuptools>=77.0.1",
     "wheel",
-    "Cython~=3.2",
+    "Cython>=3.2",
 ]
 build-backend = "setuptools.build_meta"
 
