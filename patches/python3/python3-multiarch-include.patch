From 23df2fe885bd7ac3d5535ab03b73c6801569cd99 Mon Sep 17 00:00:00 2001
From: Aedan McHale <aedan.mchale@codethink.co.uk>
Date: Tue, 27 Oct 2026 09:13:06 +0000
Subject: [PATCH 1/1] Fix issues with python architecture-specific include path

---
 Lib/sysconfig/__init__.py    |  2 +-
 Makefile.pre.in              |  5 +++--
 Misc/python-config.in        |  4 ++--
 Misc/python-config.sh.in     | 20 +++++---------------
 Misc/python.pc.in            |  2 +-
 Modules/expat/expat_config.h |  2 +-
 configure                    | 11 +++++++++++
 configure.ac                 |  7 +++++++
 8 files changed, 31 insertions(+), 22 deletions(-)

diff --git a/Lib/sysconfig/__init__.py b/Lib/sysconfig/__init__.py
index a91c27f2e8f..d574d40b03a 100644
--- a/Lib/sysconfig/__init__.py
+++ b/Lib/sysconfig/__init__.py
@@ -34,7 +34,7 @@
         'include':
             '{installed_base}/include/{implementation_lower}{py_version_short}{abiflags}',
         'platinclude':
-            '{installed_platbase}/include/{implementation_lower}{py_version_short}{abiflags}',
+            '{CONFINCLUDEDIR}/{implementation_lower}{py_version_short}{abiflags}',
         'scripts': '{base}/bin',
         'data': '{base}',
         },
diff --git a/Makefile.pre.in b/Makefile.pre.in
index 1a508f5c41c..e3b46947cb6 100644
--- a/Makefile.pre.in
+++ b/Makefile.pre.in
@@ -158,7 +158,7 @@ BINDIR=		@bindir@
 LIBDIR=		@libdir@
 MANDIR=		@mandir@
 INCLUDEDIR=	@includedir@
-CONFINCLUDEDIR=	$(exec_prefix)/include
+CONFINCLUDEDIR=	@CONFINCLUDEDIR@
 PLATLIBDIR=	@PLATLIBDIR@
 SCRIPTDIR=	$(prefix)/$(PLATLIBDIR)
 # executable name for shebangs
@@ -2844,7 +2844,8 @@ libinstall:	all $(srcdir)/Modules/xxmodule.c
 python-config: $(srcdir)/Misc/python-config.in Misc/python-config.sh
 	@ # Substitution happens here, as the completely-expanded BINDIR
 	@ # is not available in configure
-	sed -e "s,@EXENAME@,$(EXENAME)," < $(srcdir)/Misc/python-config.in >python-config.py
+	sed -e "s,@EXENAME@,$(EXENAME)," < $(srcdir)/Misc/python-config.in | \
+	    sed -e "s,@PLATINCLUDE@,$(CONFINCLUDEDIR)/python$(VERSION)$(ABIFLAGS)," >python-config.py
 	@ # Replace makefile compat. variable references with shell script compat. ones; $(VAR) -> ${VAR}
 	LC_ALL=C sed -e 's,\$$(\([A-Za-z0-9_]*\)),\$$\{\1\},g' < Misc/python-config.sh >python-config
 	@ # On Darwin, always use the python version of the script, the shell
diff --git a/Misc/python-config.in b/Misc/python-config.in
index dd5d161ab22..fa419f8eb83 100644
--- a/Misc/python-config.in
+++ b/Misc/python-config.in
@@ -41,8 +41,8 @@ for opt in opt_flags:
         print(getvar('exec_prefix'))
 
     elif opt in ('--includes', '--cflags'):
-        flags = ['-I' + sysconfig.get_path('include'),
-                 '-I' + sysconfig.get_path('platinclude')]
+        flags = ['-I' + sysconfig.get_path('platinclude'),
+                 '-I' + sysconfig.get_path('include')]
         if opt == '--cflags':
             flags.extend(getvar('CFLAGS').split())
         print(' '.join(flags))
diff --git a/Misc/python-config.sh.in b/Misc/python-config.sh.in
index 39b0031b58b..f972f508520 100644
--- a/Misc/python-config.sh.in
+++ b/Misc/python-config.sh.in
@@ -45,20 +45,10 @@ prefix_real=$(installed_prefix "$0") || {
 prefix="@prefix@"
 exec_prefix="@exec_prefix@"
 exec_prefix_real=${prefix_real}
-relocate ()
-{
-    case "$1" in
-        *"$prefix"*)
-            printf '%s\n' "${1%%"$prefix"*}${prefix_real}${1#*"$prefix"}"
-        ;;
-        *)
-            printf '%s\n' "$1"
-        ;;
-    esac
-}
-includedir=$(relocate "@includedir@")
-libdir=$(relocate "@libdir@")
-CFLAGS=$(relocate "@CFLAGS@")
+includedir=$(echo "@includedir@" | sed "s#$prefix#$prefix_real#")
+confincludedir=$(echo "@CONFINCLUDEDIR@" | sed "s#$exec_prefix#$exec_prefix_real#")
+libdir=$(echo "@libdir@" | sed "s#$prefix#$prefix_real#")
+CFLAGS=$(echo "@CFLAGS@" | sed "s#$prefix#$prefix_real#")
 VERSION="@VERSION@"
 LIBM="@LIBM@"
 LIBC="@LIBC@"
@@ -76,7 +66,7 @@ LIBPL=$(relocate "@LIBPL@")
 SO="@EXT_SUFFIX@"
 PYTHONFRAMEWORK="@PYTHONFRAMEWORK@"
 INCDIR="-I$includedir/python${VERSION}${ABIFLAGS}"
-PLATINCDIR="-I$includedir/python${VERSION}${ABIFLAGS}"
+PLATINCDIR="-I$confincludedir/python${VERSION}${ABIFLAGS}"
 PY_EMBED=0
 
 # Scan for --help or unknown argument.
diff --git a/Misc/python.pc.in b/Misc/python.pc.in
index 027dba38585..18e0d5f0a1c 100644
--- a/Misc/python.pc.in
+++ b/Misc/python.pc.in
@@ -10,4 +10,4 @@ Requires:
 Version: @VERSION@
 Libs.private: @LIBS@
 Libs: -L${libdir} @LIBPYTHON@
-Cflags: -I${includedir}/python@VERSION@@ABIFLAGS@
+Cflags: -I@CONFINCLUDEDIR@/python@VERSION@@ABIFLAGS@ -I${includedir}/python@VERSION@@ABIFLAGS@
diff --git a/Modules/expat/expat_config.h b/Modules/expat/expat_config.h
index 70df73c8e00..627cd3b9ea5 100644
--- a/Modules/expat/expat_config.h
+++ b/Modules/expat/expat_config.h
@@ -5,7 +5,7 @@
 #ifndef EXPAT_CONFIG_H
 #define EXPAT_CONFIG_H 1
 
-#include <pyconfig.h>
+#include "pyconfig.h"
 #ifdef WORDS_BIGENDIAN
 #define BYTEORDER 4321
 #else
diff --git a/configure b/configure
index 2a4b6fc96cc..fbc583d4a76 100755
--- a/configure
+++ b/configure
@@ -951,6 +951,7 @@ LIBRARY_DEPS
 HOSTRUNNER
 NODE
 STATIC_LIBPYTHON
+CONFINCLUDEDIR
 GNULD
 EXPORTSFROM
 EXPORTSYMS
@@ -1138,6 +1139,7 @@ with_ensurepip
 with_openssl
 with_openssl_rpath
 with_ssl_default_suites
+with_conf_includedir
 with_builtin_hashlib_hashes
 enable_test_modules
 '
@@ -1961,6 +1963,8 @@ Optional Packages:
                           leave OpenSSL's defaults untouched, STRING: use a
                           custom string, python and STRING also set TLS 1.2 as
                           minimum TLS version
+  --with-conf-includedir=PATH
+                          Path to pyconfig.h [EXEC_PREFIX/include]
   --with-builtin-hashlib-hashes=md5,sha1,sha2,sha3,blake2
                           builtin hash modules, md5, sha1, sha2, sha3 (with
                           shake), blake2
@@ -2046,6 +2050,13 @@ _ACEOF
 ac_status=$?
 fi
 
+# Check whether --with-conf-includedir was given.
+if test "${with_conf_includedir+set}" = set; then :
+  withval=$with_conf_includedir; CONFINCLUDEDIR="$withval"
+else
+  CONFINCLUDEDIR="${exec_prefix}/include"
+fi
+
 if test "$ac_init_help" = "recursive"; then
   # If there are subdirs, report their specific --help.
   for ac_dir in : $ac_subdirs_all; do test "x$ac_dir" = x: && continue
diff --git a/configure.ac b/configure.ac
index f51935d8813..15a064df9c4 100644
--- a/configure.ac
+++ b/configure.ac
@@ -8373,6 +8373,13 @@ PY_STDLIB_MOD([xxlimited_35], [test "$TEST_MODULES" = yes], [test "$ac_cv_func_d
 # substitute multiline block, must come after last PY_STDLIB_MOD()
 AC_SUBST([MODULE_BLOCK])
 
+AC_ARG_WITH(conf-includedir,
+            AS_HELP_STRING([--with-conf-includedir=PATH],
+                           [Path to pyconfig.h [EXEC_PREFIX/include]]),
+   [CONFINCLUDEDIR="$withval"],
+   [CONFINCLUDEDIR="${exec_prefix}/include"])
+AC_SUBST(CONFINCLUDEDIR)
+ 
 # generate output files
 AC_CONFIG_FILES(m4_normalize([
   Makefile.pre
-- 
2.56.0

