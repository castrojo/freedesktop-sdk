+@cython.cclass
+class OrderedSet:
+    """
+    Simple ordered set based on an ordered Python dict.
+    """
+    _keys: dict
+
+    def __init__(self):
+        self._keys = {}
+
+    def repr(self):
+        return f"{{{', '.join(map(repr, self._keys))}}}"
+
+    def add(self, key):
+        self._keys[key] = None
+
+    def update(self, keys: list):
+        set_keys = self._keys
+        for key in keys:
+            set_keys[key] = None
+
+    def difference_update(self, keys: set):
+        set_keys = self._keys
+        # We expect len(keys) < len(set_keys).
+        for key in keys:
+            if key in set_keys:
+                del set_keys[key]
+
+    def __iter__(self):
+        return iter(self._keys)
+
