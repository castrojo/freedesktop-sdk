diff --git a/utils/ipa-embed-checksums.py b/utils/ipa-embed-checksums.py
new file mode 100644
index 00000000..7289a6e9
--- /dev/null
+++ b/utils/ipa-embed-checksums.py
@@ -0,0 +1,60 @@
+import argparse
+import hashlib
+import subprocess
+import tempfile
+from pathlib import Path
+
+section_name = ".ipa_trusted_checksums"
+checksum_size = 32
+section_size = 64 * checksum_size
+
+parser = argparse.ArgumentParser()
+parser.add_argument("library", type=Path)
+parser.add_argument("modules", nargs="*", type=Path)
+arguments = parser.parse_args()
+
+library_path = arguments.library.resolve(strict=True)
+checksums = set()
+
+for module_path in arguments.modules:
+    if module_path.is_symlink() or not module_path.is_file():
+        raise SystemExit(f"Invalid IPA module: {module_path}")
+
+    checksum = hashlib.sha256(module_path.read_bytes()).digest()
+    checksums.add(checksum)
+
+    print(f"{checksum.hex()}  {module_path.name}")
+
+checksum_data = b"".join(sorted(checksums))
+
+if len(checksum_data) > section_size:
+    raise SystemExit("Too many IPA checksums")
+
+checksum_data = checksum_data.ljust(section_size, b"\x00")
+
+with tempfile.TemporaryDirectory() as directory:
+    temporary_directory = Path(directory)
+    section_file = temporary_directory / "checksums.bin"
+    inspection_file = temporary_directory / "inspection.so"
+
+    subprocess.run([
+        "objcopy",
+        "--dump-section",
+        f"{section_name}={section_file}",
+        str(library_path),
+        str(inspection_file)
+    ], check=True)
+
+    if section_file.read_bytes() != bytes(section_size):
+        raise SystemExit("Expected an empty 2048-byte checksum section")
+
+    section_file.write_bytes(checksum_data)
+
+    subprocess.run([
+        "objcopy",
+        "--update-section",
+        f"{section_name}={section_file}",
+        str(library_path)
+    ], check=True)
+
+print(f"Embedded {len(checksums)} trusted IPA checksums into {library_path}")
