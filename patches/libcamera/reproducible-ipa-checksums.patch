+#if HAVE_IPA_TRUSTED_MODULE_CHECKSUMS
+
+/*
+ * Reserve a read-only ELF section for trusted IPA checksums.
+ * The packaging process populates this section after stripping.
+ */
+asm(R"(
+    .pushsection .ipa_trusted_checksums,"a",%progbits
+    .balign 32
+    .global ipaTrustedChecksums
+    .hidden ipaTrustedChecksums
+    .type ipaTrustedChecksums,%object
+ipaTrustedChecksums:
+    .zero 2048
+    .size ipaTrustedChecksums, . - ipaTrustedChecksums
+    .popsection
+)");
+
+extern "C" const uint8_t ipaTrustedChecksums[64][32]
+    __attribute__((visibility("hidden")));
+
+bool IPAManager::isChecksumTrusted(IPAModule *ipa)
+{
+	const std::string &modulePath = ipa->path();
+	const std::string installedDirectory = std::string(IPA_MODULE_DIR) + "/";
+
+	if (!modulePath.starts_with(installedDirectory))
+	    return false;
+
+	const std::string moduleName = modulePath.substr(installedDirectory.size());
+
+	if (moduleName.find('/') != std::string::npos ||
+	    !moduleName.ends_with(".so"))
+	    return false;
+
+	File file{ modulePath };
+
+	if (!file.open(File::OpenModeFlag::ReadOnly))
+		return false;
+
+	Span<uint8_t> data = file.map();
+	if (data.empty())
+		return false;
+
+	uint8_t digest[32];
+
+#if HAVE_CRYPTO
+	if (!SHA256(data.data(), data.size(), digest))
+		return false;
+#elif HAVE_GNUTLS
+	if (gnutls_hash_fast(GNUTLS_DIG_SHA256,
+			     data.data(), data.size(), digest) != 0)
+		return false;
+#else
+	return false;
+#endif
+
+	static constexpr uint8_t emptyChecksum[32] = {};
+
+	if (std::memcmp(digest, emptyChecksum, sizeof(digest)) == 0)
+		return false;
+
+	for (const auto &trustedChecksum : ipaTrustedChecksums) {
+		if (std::memcmp(digest, trustedChecksum, sizeof(digest)) == 0)
+			return true;
+	}
+
+	return false;
+}
+#endif
+
 } /* namespace libcamera */
