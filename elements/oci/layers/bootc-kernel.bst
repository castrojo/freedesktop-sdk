kind: script
description: Generate bootc OSTree initramfs

build-depends:
  # Use the same dracut/tooling stack the VM ostree boot elements use, so
  # the build environment has everything dracut's shell scripts need
  # (grep, sed, awk, find, /var/tmp, etc.).
  # components/bootc.bst ships the 'bootc' dracut module (composefs root
  # setup) that 50-bootc.conf enables below.
- public-stacks/runtime-gnu.bst
- components/bootc.bst
- components/dbus.bst
- components/dracut.bst
- components/findutils.bst
- components/linux.bst
- components/os-release.bst
- components/ostree.bst
- components/pkg-config.bst
- components/sed.bst
- components/shadow.bst
- components/systemd.bst
- components/tzdata.bst
- components/util-linux-full.bst

config:
  commands:
  - |
    set -eu

    # dracut uses /var/tmp as its working tmpdir.
    mkdir -p /tmp /var/tmp

    set -- /usr/lib/modules/*
    test "$#" -eq 1
    test -d "$1"
    kver="${1##*/}"

    test -f "/usr/lib/modules/$kver/vmlinuz"

    # dracut requires the kernel module dependency database (modules.dep),
    # which is generated by depmod. This mirrors what prepare-image.sh does
    # when it runs without --nodepmod.
    depmod -b / "${kver}"

    # Enable bootc's composefs root setup in Dracut.
    mkdir -p /usr/lib/dracut/dracut.conf.d
    cat > /usr/lib/dracut/dracut.conf.d/50-bootc.conf <<'EOF'
    add_dracutmodules+=" bootc "
    EOF

    # Generate an image for the target kernel
    mkdir -p "/usr/lib/modules/$kver"
    DRACUT_NO_XATTR=1 dracut \
      --force \
      --xz \
      --reproducible \
      --no-hostonly \
      --no-machineid \
      --kver "$kver" \
      "/usr/lib/modules/$kver/initramfs.img"

    # Script element output is collected from %{install-root}, so copy the
    # kernel and initramfs there for bootc-oci to pick up.
    mkdir -p "%{install-root}/usr/lib/modules/$kver"
    cp "/usr/lib/modules/$kver/vmlinuz" "%{install-root}/usr/lib/modules/$kver/vmlinuz"
    cp "/usr/lib/modules/$kver/initramfs.img" "%{install-root}/usr/lib/modules/$kver/initramfs.img"
